<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_xapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.xapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="xapp_quotation_terms_setting" string="Xapp Quotation Terms" help="Default terms and conditions for Xapp Quotation Report">
                    <field name="xapp_quotation_terms"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
