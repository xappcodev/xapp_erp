<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================================
         Custom External Layout for Xapp Quotation
         Modern, print-ready, corporate document style.
         All dynamic bindings / business logic preserved from original.
    ====================================================================== -->
    <template id="xapp_external_layout">
        <div class="article xapp-quotation" t-att-data-oe-model="doc and doc._name" t-att-data-oe-id="doc and doc.id" t-att-data-oe-lang="doc and doc.env.context.get('lang')">
            <style>
                /* ---------------------------------------------------------
                   DESIGN TOKENS
                ------------------------------------------------------------ */
                :root {
                    --xapp-ink: #1a1d29;
                    --xapp-ink-soft: #3d4152;
                    --xapp-muted: #8a8d99;
                    --xapp-line: #e6e5eb;
                    --xapp-line-strong: #d3d2db;
                    --xapp-accent: #2b3a67;
                    --xapp-accent-soft: #eef1f8;
                    --xapp-surface: #fafafa;
                    --xapp-white: #ffffff;
                    --xapp-success: #2f7d5f;

                    --xapp-font-body: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                    --xapp-font-display: Georgia, 'Times New Roman', Times, serif;
                }

                /* ---------------------------------------------------------
                   PAGE / PRINT SETUP
                ------------------------------------------------------------ */
                @page {
                    margin: 18mm 16mm;
                }

                .xapp-quotation {
                    font-family: var(--xapp-font-body);
                    color: var(--xapp-ink-soft);
                    font-size: 12.5px;
                    line-height: 1.6;
                    -webkit-font-smoothing: antialiased;
                }

                .xapp-quotation * {
                    box-sizing: border-box;
                }

                .xapp-avoid-break {
                    page-break-inside: avoid;
                }

                /* ---------------------------------------------------------
                   HEADER
                ------------------------------------------------------------ */
                .xapp-header {
                    display: table;
                    width: 100%;
                    margin-bottom: 26px;
                    padding-bottom: 20px;
                    border-bottom: 2px solid var(--xapp-ink);
                }
                .xapp-header-col {
                    display: table-cell;
                    vertical-align: top;
                }
                .xapp-header-col.xapp-align-right {
                    text-align: right;
                }
                .xapp-logo-img {
                    max-height: 48px;
                    max-width: 220px;
                }
                .xapp-logo-text {
                    font-family: var(--xapp-font-display);
                    font-size: 22px;
                    font-weight: 400;
                    color: var(--xapp-ink);
                    letter-spacing: 2px;
                    text-transform: uppercase;
                }
                .xapp-company-line {
                    margin-top: 10px;
                    font-size: 10.5px;
                    color: var(--xapp-muted);
                    line-height: 1.7;
                    letter-spacing: 0.15px;
                }
                .xapp-doc-badge {
                    display: inline-block;
                    font-size: 9px;
                    font-weight: 700;
                    letter-spacing: 1.6px;
                    text-transform: uppercase;
                    color: var(--xapp-accent);
                    background-color: var(--xapp-accent-soft);
                    padding: 4px 10px;
                    border-radius: 3px;
                    margin-bottom: 10px;
                }
                .xapp-quote-title {
                    font-size: 20px;
                    font-weight: 700;
                    letter-spacing: 0.2px;
                    color: var(--xapp-ink);
                    margin-bottom: 4px;
                }
                .xapp-quote-subtitle {
                    font-size: 12px;
                    font-weight: 600;
                    color: var(--xapp-muted);
                    letter-spacing: 0.4px;
                }

                /* ---------------------------------------------------------
                   BILL TO / META GRID
                ------------------------------------------------------------ */
                .xapp-details-grid {
                    display: table;
                    width: 100%;
                    table-layout: fixed;
                    margin-bottom: 30px;
                }
                .xapp-bill-to {
                    display: table-cell;
                    width: 56%;
                    vertical-align: top;
                    padding-right: 28px;
                }
                .xapp-eyebrow {
                    font-size: 9.5px;
                    font-weight: 700;
                    letter-spacing: 1.6px;
                    text-transform: uppercase;
                    color: var(--xapp-muted);
                    margin-bottom: 8px;
                }
                .xapp-bill-name {
                    font-weight: 700;
                    font-size: 14.5px;
                    color: var(--xapp-ink);
                    margin-bottom: 5px;
                }
                .xapp-bill-detail {
                    color: var(--xapp-muted);
                    font-size: 11px;
                    line-height: 1.8;
                }
                .xapp-meta-box {
                    display: table-cell;
                    width: 44%;
                    vertical-align: top;
                }
                .xapp-meta-table {
                    width: 100%;
                    border-collapse: collapse;
                }
                .xapp-meta-table tr {
                    border-bottom: 1px solid var(--xapp-line);
                }
                .xapp-meta-table tr:last-child {
                    border-bottom: none;
                }
                .xapp-meta-table td {
                    padding: 7px 0;
                    font-size: 11px;
                }
                .xapp-meta-label {
                    color: var(--xapp-muted);
                    letter-spacing: 0.2px;
                }
                .xapp-meta-value {
                    text-align: right;
                    font-weight: 600;
                    color: var(--xapp-ink);
                }

                /* ---------------------------------------------------------
                   LINE ITEMS TABLE
                ------------------------------------------------------------ */
                .xapp-lines-table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-bottom: 0;
                }
                .xapp-lines-table thead {
                    display: table-header-group; /* repeat header on each printed page */
                }
                .xapp-lines-table th {
                    background-color: var(--xapp-ink);
                    color: var(--xapp-white);
                    padding: 10px 12px;
                    text-align: left;
                    font-weight: 600;
                    font-size: 9px;
                    letter-spacing: 0.9px;
                    text-transform: uppercase;
                }
                .xapp-lines-table th:first-child {
                    border-top-left-radius: 3px;
                }
                .xapp-lines-table th:last-child {
                    border-top-right-radius: 3px;
                }
                .xapp-lines-table th.xapp-num {
                    text-align: right;
                }
                .xapp-lines-table tbody tr {
                    page-break-inside: avoid;
                }
                .xapp-lines-table td {
                    padding: 11px 12px;
                    vertical-align: top;
                    border-bottom: 1px solid var(--xapp-line);
                    font-size: 11.5px;
                }
                .xapp-lines-table tbody tr:nth-child(even) {
                    background-color: var(--xapp-surface);
                }
                .xapp-lines-table td.xapp-num {
                    text-align: right;
                    white-space: nowrap;
                }
                .xapp-line-title {
                    display: block;
                    font-weight: 600;
                    color: var(--xapp-ink);
                    margin-bottom: 3px;
                }
                .xapp-line-sub {
                    color: var(--xapp-muted);
                    font-size: 10.5px;
                    line-height: 1.6;
                }

                /* ---------------------------------------------------------
                   TOTALS SUMMARY
                ------------------------------------------------------------ */
                .xapp-totals-wrap {
                    display: table;
                    width: 100%;
                    table-layout: fixed;
                    margin-bottom: 30px;
                }
                .xapp-totals-spacer {
                    display: table-cell;
                    width: 55%;
                }
                .xapp-totals-box {
                    display: table-cell;
                    width: 45%;
                    vertical-align: top;
                }
                .xapp-totals-table {
                    width: 100%;
                    border-collapse: collapse;
                }
                .xapp-totals-table td {
                    padding: 7px 12px;
                    font-size: 11.5px;
                }
                .xapp-totals-table td:first-child {
                    color: var(--xapp-muted);
                }
                .xapp-totals-table td.xapp-num {
                    text-align: right;
                    font-weight: 600;
                    color: var(--xapp-ink);
                    white-space: nowrap;
                }
                .xapp-totals-table tr.xapp-grand-total td {
                    border-top: 2px solid var(--xapp-ink);
                    padding-top: 12px;
                    font-size: 15px;
                    font-weight: 700;
                    color: var(--xapp-ink);
                }
                .xapp-totals-table tr.xapp-grand-total td:first-child {
                    color: var(--xapp-ink);
                    text-transform: uppercase;
                    font-size: 10.5px;
                    letter-spacing: 0.8px;
                    font-weight: 700;
                }

                /* ---------------------------------------------------------
                   SECTION HEADING
                ------------------------------------------------------------ */
                .xapp-section-heading {
                    font-size: 13px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.8px;
                    margin: 0 0 14px 0;
                    color: var(--xapp-ink);
                    padding-bottom: 8px;
                    border-bottom: 2px solid var(--xapp-ink);
                }
                .xapp-section {
                    margin-bottom: 30px;
                }

                /* ---------------------------------------------------------
                   PAYMENT PLAN TABLE
                ------------------------------------------------------------ */
                .xapp-payment-table {
                    width: 100%;
                    border-collapse: collapse;
                }
                .xapp-payment-table thead {
                    display: table-header-group;
                }
                .xapp-payment-table th {
                    background-color: var(--xapp-accent-soft);
                    font-weight: 700;
                    font-size: 9px;
                    letter-spacing: 0.7px;
                    text-transform: uppercase;
                    color: var(--xapp-accent);
                    text-align: left;
                    padding: 9px 12px;
                    border-bottom: 2px solid var(--xapp-accent);
                }
                .xapp-payment-table th.xapp-num {
                    text-align: right;
                }
                .xapp-payment-table td {
                    padding: 10px 12px;
                    border-bottom: 1px solid var(--xapp-line);
                    font-size: 11px;
                    vertical-align: top;
                }
                .xapp-payment-table tr {
                    page-break-inside: avoid;
                }
                .xapp-payment-table td.xapp-num {
                    text-align: right;
                    white-space: nowrap;
                    font-weight: 600;
                }
                .xapp-payment-stage {
                    font-weight: 700;
                    color: var(--xapp-ink);
                }
                .xapp-payment-pct {
                    display: inline-block;
                    font-size: 9.5px;
                    color: var(--xapp-accent);
                    font-weight: 700;
                    margin-right: 4px;
                }

                /* ---------------------------------------------------------
                   TERMS
                ------------------------------------------------------------ */
                .xapp-terms-body {
                    font-size: 10.5px;
                    color: var(--xapp-muted);
                    line-height: 1.85;
                }

                /* ---------------------------------------------------------
                   SIGNATURE BLOCK
                ------------------------------------------------------------ */
                .xapp-acceptance-note {
                    background-color: var(--xapp-accent-soft);
                    border-left: 3px solid var(--xapp-accent);
                    border-radius: 0 3px 3px 0;
                    padding: 12px 16px;
                    margin-bottom: 24px;
                    font-size: 11px;
                    color: var(--xapp-ink-soft);
                }
                .xapp-acceptance-note strong {
                    color: var(--xapp-ink);
                }
                .xapp-signature-box {
                    display: table;
                    width: 100%;
                    table-layout: fixed;
                }
                .xapp-sign-col {
                    display: table-cell;
                    width: 47%;
                    vertical-align: top;
                }
                .xapp-sign-spacer {
                    display: table-cell;
                    width: 6%;
                }
                .xapp-sign-heading {
                    font-weight: 700;
                    font-size: 9.5px;
                    text-transform: uppercase;
                    letter-spacing: 0.9px;
                    color: var(--xapp-muted);
                    margin-bottom: 18px;
                    padding-bottom: 8px;
                    border-bottom: 1px solid var(--xapp-line-strong);
                }
                .xapp-sign-line, .xapp-sign-value {
                    border-bottom: 1px dotted #b7b6bf;
                    margin: 22px 0 5px 0;
                    height: 16px;
                }
                .xapp-sign-value {
                    font-weight: 600;
                    color: var(--xapp-ink);
                }
                .xapp-sign-label {
                    font-size: 9.5px;
                    color: var(--xapp-muted);
                    letter-spacing: 0.2px;
                }

                /* ---------------------------------------------------------
                   FOOTER
                ------------------------------------------------------------ */
                .xapp-footer {
                    text-align: center;
                    font-size: 9.5px;
                    color: var(--xapp-muted);
                    margin-top: 44px;
                    border-top: 1px solid var(--xapp-line);
                    padding-top: 14px;
                    letter-spacing: 0.3px;
                }
            </style>

            <t t-out="0"/>

            <div class="xapp-footer">
                <span t-if="doc.company_id.phone"><t t-out="doc.company_id.phone"/></span>
                <span t-if="doc.company_id.phone and doc.company_id.email"> &#183; </span>
                <span t-if="doc.company_id.email"><t t-out="doc.company_id.email"/></span>
                <span t-if="(doc.company_id.phone or doc.company_id.email) and doc.company_id.website"> &#183; </span>
                <span t-if="doc.company_id.website"><t t-out="doc.company_id.website"/></span>
            </div>
        </div>
    </template>

    <template id="report_xapp_quotation_template_document">
        <t t-call="xapp_quotation_template.xapp_external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>

            <!-- =============================== HEADER =============================== -->
            <div class="xapp-header xapp-avoid-break">
                <div class="xapp-header-col" style="width: 52%;">
                    <t t-if="doc.company_id.logo">
                        <img t-att-src="image_data_uri(doc.company_id.logo)" class="xapp-logo-img" alt="Logo"/>
                    </t>
                    <t t-else="">
                        <div class="xapp-logo-text"><t t-out="doc.company_id.name"/></div>
                    </t>
                    <div class="xapp-company-line">
                        <t t-if="doc.company_id.street"><t t-out="doc.company_id.street"/><br/></t>
                        <t t-if="doc.company_id.city">
                            <t t-out="doc.company_id.city"/><t t-if="doc.company_id.country_id">, <t t-out="doc.company_id.country_id.name"/></t>
                        </t>
                    </div>
                </div>
                <div class="xapp-header-col xapp-align-right" style="width: 48%;">
                    <t t-set="dynamic_title" t-value="'Software Development Quote'"/>
                    <t t-if="doc.xapp_development_type">
                        <t t-set="dynamic_title" t-value="doc.xapp_development_type + ' Development Quote'"/>
                    </t>
                    <t t-elif="doc.order_line">
                        <t t-set="first_line" t-value="doc.order_line[0]"/>
                        <t t-if="first_line.product_id and first_line.product_id.categ_id">
                            <t t-set="dynamic_title" t-value="first_line.product_id.categ_id.name + ' Quote'"/>
                        </t>
                        <t t-elif="first_line.name">
                            <t t-set="dynamic_title" t-value="first_line.name.split('\n')[0] + ' Quote'"/>
                        </t>
                    </t>
                    <div class="xapp-doc-badge">Quotation</div>
                    <div class="xapp-quote-title"><t t-out="dynamic_title"/></div>
                    <div class="xapp-quote-subtitle">#<span t-field="doc.name"/></div>
                </div>
            </div>

            <!-- ======================== BILL TO / META ======================== -->
            <div class="xapp-details-grid xapp-avoid-break">
                <div class="xapp-bill-to">
                    <div class="xapp-eyebrow">Bill To</div>
                    <div class="xapp-bill-name"><span t-field="doc.partner_id.name"/></div>
                    <div class="xapp-bill-detail">
                        <t t-if="doc.partner_id.street"><span t-field="doc.partner_id.street"/><br/></t>
                        <t t-if="doc.partner_id.city"><span t-field="doc.partner_id.city"/><t t-if="doc.partner_id.country_id">, </t></t>
                        <t t-if="doc.partner_id.country_id"><span t-field="doc.partner_id.country_id.name"/><br/></t>
                        <t t-if="doc.partner_id.phone">Mob: <span t-field="doc.partner_id.phone"/><br/></t>
                        <t t-if="doc.partner_id.email">Email: <span t-field="doc.partner_id.email"/></t>
                    </div>
                </div>

                <div class="xapp-meta-box">
                    <table class="xapp-meta-table">
                        <tr>
                            <td class="xapp-meta-label">Salesperson</td>
                            <td class="xapp-meta-value"><span t-field="doc.user_id.name"/></td>
                        </tr>
                        <tr>
                            <td class="xapp-meta-label">Quote #</td>
                            <td class="xapp-meta-value"><span t-field="doc.name"/></td>
                        </tr>
                        <tr>
                            <td class="xapp-meta-label">Quote Date</td>
                            <td class="xapp-meta-value"><span t-field="doc.date_order" t-options='{"widget": "date"}'/></td>
                        </tr>
                        <tr t-if="doc.validity_date">
                            <td class="xapp-meta-label">Valid Until</td>
                            <td class="xapp-meta-value"><span t-field="doc.validity_date" t-options='{"widget": "date"}'/></td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- ========================= LINE ITEMS TABLE ========================= -->
            <t t-set="has_discount" t-value="any(l.discount for l in doc.order_line if 'discount' in l._fields)"/>
            <table class="xapp-lines-table">
                <thead>
                    <tr>
                        <th style="width: 8%;">Qty</th>
                        <th t-attf-style="width: #{'34' if has_discount else '44'}%;">Description</th>
                        <th class="xapp-num" style="width: 16%;">Unit Price</th>
                        <t t-if="has_discount">
                            <th class="xapp-num" style="width: 12%;">Discount</th>
                        </t>
                        <th class="xapp-num" t-attf-style="width: #{'18' if has_discount else '22'}%;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="doc.order_line" t-as="line">
                        <tr>
                            <td>
                                <span t-field="line.product_uom_qty"/> <span t-field="line.product_uom" groups="uom.group_uom"/>
                            </td>
                            <td>
                                <t t-set="line_desc" t-value="line.name.split('\n')"/>
                                <span class="xapp-line-title"><t t-out="line_desc[0]"/></span>
                                <t t-if="len(line_desc) > 1">
                                    <span class="xapp-line-sub">
                                        <t t-foreach="line_desc[1:]" t-as="subline">
                                            <t t-out="subline"/><br/>
                                        </t>
                                    </span>
                                </t>
                            </td>
                            <td class="xapp-num">
                                <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                            <t t-if="has_discount">
                                <td class="xapp-num">
                                    <t t-if="line.discount">
                                        <t t-out="'%.2f' % line.discount"/>%
                                    </t>
                                    <t t-else="">&#8212;</t>
                                </td>
                            </t>
                            <td class="xapp-num">
                                <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <!-- ========================= TOTALS SUMMARY ========================= -->
            <div class="xapp-totals-wrap xapp-avoid-break">
                <div class="xapp-totals-spacer"></div>
                <div class="xapp-totals-box">
                    <table class="xapp-totals-table">
                        <t t-if="'amount_untaxed' in doc._fields">
                            <tr>
                                <td>Subtotal</td>
                                <td class="xapp-num">
                                    <span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                        <t t-if="'amount_tax' in doc._fields">
                            <tr>
                                <td>Tax</td>
                                <td class="xapp-num">
                                    <span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                        <tr class="xapp-grand-total">
                            <td>Total (<t t-out="doc.currency_id.name"/>)</td>
                            <td class="xapp-num">
                                <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- ========================= PAYMENT PLAN TABLE ========================= -->
            <t t-if="'xapp_payment_plan_ids' in doc._fields and doc.xapp_payment_plan_ids">
                <t t-set="order_type" t-value="'Order' if doc.state in ('sale', 'done') else 'Quotation'"/>
                <div class="xapp-section">
                    <div class="xapp-section-heading">
                        Payment Plan for <t t-out="order_type"/> (<span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>)
                    </div>
                    <table class="xapp-payment-table">
                        <thead>
                            <tr>
                                <th style="width: 26%;">Payment Stage</th>
                                <th style="width: 48%;">Description</th>
                                <th class="xapp-num" style="width: 26%;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.xapp_payment_plan_ids" t-as="plan">
                                <tr>
                                    <td><span class="xapp-payment-stage" t-field="plan.name"/></td>
                                    <td><span t-field="plan.description"/></td>
                                    <td class="xapp-num">
                                        <span class="xapp-payment-pct"><t t-out="int(plan.percentage)"/>%</span>
                                        <span t-field="plan.amount" t-options='{"widget": "monetary", "display_currency": plan.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>

            <!-- ========================= TERMS AND CONDITIONS ========================= -->
            <t t-if="'xapp_quotation_terms' in doc._fields and doc.xapp_quotation_terms">
                <div class="xapp-section">
                    <div class="xapp-section-heading">Terms &amp; Conditions</div>
                    <div class="xapp-terms-body">
                        <t t-out="doc.xapp_quotation_terms"/>
                    </div>
                </div>
            </t>

            <!-- ========================= SIGNATURE BLOCK ========================= -->
            <div class="xapp-avoid-break">
                <div class="xapp-acceptance-note">
                    This quotation <strong><t t-out="doc.name"/></strong> is valid until <span t-field="doc.validity_date"/>. Please sign below to indicate your acceptance of this quotation and the attached terms.
                </div>
                <div class="xapp-signature-box">
                    <div class="xapp-sign-col">
                        <div class="xapp-sign-heading">For Customer</div>

                        <div class="xapp-sign-line"></div>
                        <div class="xapp-sign-label">Name &amp; Signature</div>

                        <div class="xapp-sign-line"></div>
                        <div class="xapp-sign-label">Designation</div>

                        <div class="xapp-sign-line"></div>
                        <div class="xapp-sign-label">Date</div>
                    </div>

                    <div class="xapp-sign-spacer"></div>

                    <div class="xapp-sign-col">
                        <div class="xapp-sign-heading">For <t t-out="doc.company_id.name"/></div>

                        <div class="xapp-sign-value"><span t-field="doc.user_id.name"/></div>
                        <div class="xapp-sign-label">Name &amp; Signature</div>

                        <t t-set="salesperson_job" t-value="doc.user_id.function or 'Salesperson'"/>
                        <div class="xapp-sign-value"><t t-out="salesperson_job"/></div>
                        <div class="xapp-sign-label">Designation</div>

                        <div class="xapp-sign-line"></div>
                        <div class="xapp-sign-label">Date</div>
                    </div>
                </div>
            </div>

        </t>
    </template>

    <template id="report_xapp_quotation_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="xapp_quotation_template.report_xapp_quotation_template_document"/>
            </t>
